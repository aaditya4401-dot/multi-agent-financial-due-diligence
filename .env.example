# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain a real key.
#
#   cp .env.example .env

# --- Required -------------------------------------------------------------

# Model access. Every tier in src/llm.py resolves to an OpenAI model.
OPENAI_API_KEY=sk-your-key-here

# Web search, used by every research agent.
TAVILY_API_KEY=tvly-your-key-here


# --- Observability (optional) ---------------------------------------------
# Tracing is off unless LANGSMITH_TRACING is truthy AND LANGSMITH_API_KEY is
# set. With either missing, the pipeline runs exactly as it did before this
# was added: no client is constructed and no callbacks are attached. If
# LangSmith is unreachable or the key is wrong, runs still complete — tracing
# fails open by design and never propagates an exception into the pipeline.

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=multi-agent-due-diligence

# Self-hosted or EU LangSmith only. Leave unset for the default US endpoint.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# --- Tuning (optional) ----------------------------------------------------
# Shown with their defaults; all are read from the environment at import.

# Model per routing tier. Cheap work runs on the cheap model.
# DD_MODEL_FAST=gpt-4o-mini
# DD_MODEL_REASONING=gpt-4o
# DD_MODEL_SYNTHESIS=gpt-4o

# DD_LLM_TIMEOUT=90
# DD_LLM_MAX_RETRIES=2

# Refinement loop. Rounds is the hard ceiling on the research → evidence →
# gap_analyzer cycle; VOI is the value-of-information floor a gap must clear
# to be worth another round of research.
# DD_MAX_REFINEMENT_ROUNDS=1
# DD_MAX_REFINE_TASKS=3
# DD_MIN_GAP_VOI=0.5

# Per-agent ReAct step budget, and the graph-wide backstop.
# DD_AGENT_MAX_STEPS=20
# DD_GRAPH_RECURSION_LIMIT=50

# SQLite file for resumable runs. Required for human review to survive a
# process restart.
# DD_CHECKPOINT_PATH=.dd_checkpoints.sqlite
